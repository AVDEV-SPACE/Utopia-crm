# Vercel CLI NU citește .gitignore — doar acest fișier (plus o listă implicită
# scurtă: node_modules, .next, .git, .vercel). Tot ce e greu/local trebuie listat aici,
# altfel ajunge în upload și se lovește de limita de 100 MB / fișier.

# build-uri locale
.next
.next-verify
out
build
coverage

# dependențe
node_modules

# artefacte typescript
*.tsbuildinfo
tsconfig.tsbuildinfo

# vcs / vercel
.git
.vercel

# env local (Vercel folosește variabilele din dashboard)
.env
.env.*
!.env.example

# diverse locale (NU exclude *.sql global — prisma/migrations are nevoie de ele)
.claude
docs
*.bak
setup-db*.sql
Thumbs.db
.DS_Store
