# Database
DATABASE_URL=
NEON_PRIMARY_ID=
NEON_PRIMARY_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/sign-up

# Pipeline de leaduri — import generic (/api/pipeline/leads, /api/pipeline/events)
# Cheia cerută în header-ul x-api-key (sau Authorization: Bearer) de rutele de import
CRM_PIPELINE_API_KEY=
# Tenant-ul lead-urilor din pipeline: orgId-ul Clerk sau user:<clerkUserId>
CRM_PIPELINE_ORG_ID=

# SMTP — email follow-up (educational templates)
# Generează o parolă de aplicație Google: https://myaccount.google.com/apppasswords
# Activează mai întâi 2FA pe contul Google, apoi creează o parolă de tip "Mail"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=
# Contul Gmail pe care l-ai folosit la generarea parolei de aplicatie (poate fi diferit de FROM)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Twilio — SMS (educational templates, canal SMS)
# Creează cont gratuit: https://console.twilio.com
# Account SID și Auth Token din dashboard-ul principal Twilio
# TWILIO_PHONE_NUMBER: numărul Twilio cumpărat (format E.164: +40...)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# AI Follow-Up & WhatsApp Automation (/dashboard/follow-ups-ai)
# Numărul WhatsApp Twilio (Sandbox sau număr aprobat), format E.164 fără prefixul `whatsapp:`
TWILIO_WHATSAPP_NUMBER=
# URL-ul public al CRM-ului — apare în webhook-ul afișat în UI. Ex: https://utopia-crm.com
NEXT_PUBLIC_APP_URL=
# Validarea semnăturii X-Twilio-Signature. Pune "true" DOAR în producție, unde
# URL-ul webhook-ului coincide cu cel configurat în Twilio Console.
TWILIO_VALIDATE_SIGNATURE=false
# Opțional — baza URL-ului semnat de Twilio, dacă diferă de NEXT_PUBLIC_APP_URL (proxy/tunel)
TWILIO_WEBHOOK_BASE_URL=

# Google Analytics 4 — vizualizări site în /overview
# 1. Creează un Service Account în Google Cloud Console
# 2. Acordă-i rol "Viewer" în GA4 Admin → Property Access Management
# 3. Copiază Property ID numeric din GA4 Admin → Property Settings
GA4_PROPERTY_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Lead Generation — Nominatim (OpenStreetMap) — scraping lead-uri, 100% gratuit, fără cheie API
# Policy obligatorie: https://operations.osmfoundation.org/policies/nominatim/ (max 1 req/s)
# Opțional — email de contact trimis către Nominatim (recomandat de policy, nu obligatoriu)
NOMINATIM_CONTACT_EMAIL=

# Lead Generation — Google PageSpeed Insights (scor calitate site)
GOOGLE_PAGESPEED_API_KEY=

# Lead Generation — Groq API (generare pitch-uri de vânzare, model llama-3.3-70b-versatile)
GROQ_API_KEY=

# Lead Generation — Apify (Google Maps Scraper — email/telefon/website/social/recenzii)
APIFY_API_TOKEN=

# Lead Generation — reutilizează checkout-ul Stripe existent din UTOPIA-SITE
# (vezi app/api/stripe/checkout/route.ts, flow-ul customAmount folosit de /facturare)
UTOPIA_SITE_URL=

# Joburi programate (/api/cron/*) — cerute în header-ul Authorization: Bearer <CRON_SECRET>
# Același secret se pune în GitHub → Settings → Secrets → Actions
CRON_SECRET=

# Motorul de leaduri (/pipeline → Motor leaduri)
# Model Groq pentru scor + pitch (implicit openai/gpt-oss-120b)
GROQ_MODEL=
# Plafon de lead-uri noi descoperite pe zi (implicit 150; setarea din UI are prioritate)
ENGINE_MAX_NEW_LEADS_PER_DAY=
# Bugetul de timp al unei rulări, în ms (implicit 240000; 50000 dacă proiectul Vercel nu are Fluid compute)
ENGINE_TIME_BUDGET_MS=
# Opțional: endpoint-uri Overpass, separate prin virgulă (implicit overpass-api.de, apoi overpass.kumi.systems)
OVERPASS_ENDPOINTS=
# Opțional: Meta Ad Library API (gratuit, cere confirmarea identității la facebook.com/ID)
META_ADLIB_TOKEN=
# Versiunea Graph API (implicit v26.0)
META_GRAPH_VERSION=
# Opțional, COST POTENȚIAL: Google Places rulează doar cu cheie ȘI ENGINE_ALLOW_PLACES=true
GOOGLE_PLACES_API_KEY=
ENGINE_ALLOW_PLACES=

# ── Outreach email (Faza 2) ──
# Căsuța firmei pentru outreach și mesajele din CRM (trimitere, răspunsuri). Fără ele
# se folosesc GMAIL_USER / GMAIL_APP_PASSWORD. Confirmările de programare rămân pe contul vechi.
OUTREACH_GMAIL_USER=
OUTREACH_GMAIL_APP_PASSWORD=
# Comutatorul general: fără `true` nu pleacă niciun email automat
OUTREACH_SEND_ENABLED=
# Plafoane zilnice (implicit 40 / 35 / 25). Emailul urcă treptat: 10, 20, 30 pe zi, câte o săptămână fiecare.
OUTREACH_EMAIL_DAILY_CAP=
OUTREACH_IG_DAILY_CAP=
OUTREACH_LINKEDIN_DAILY_CAP=
# Opțional: numele afișat în „De la:”
OUTREACH_SENDER_NAME=
# Opțional, pentru teste: doar aceste adrese (separate prin virgulă) primesc emailuri
OUTREACH_ALLOWED_RECIPIENTS=

# Motor leaduri — sursa Overture Maps (implicit activă; „false” o oprește)
ENGINE_OVERTURE=

# Socials — Facebook Page + Instagram Business (/socials, /api/webhooks/meta)
# App-ul din developers.facebook.com: App ID + App Secret (secretul semnează webhook-urile)
META_APP_ID=
META_APP_SECRET=
# Token de System User (Business Manager), cu pages_messaging, pages_manage_posts,
# pages_read_engagement, pages_manage_metadata, instagram_basic,
# instagram_manage_messages, instagram_manage_comments, instagram_content_publish
META_SYSTEM_USER_TOKEN=
FB_PAGE_ID=
IG_BUSINESS_ID=
# Șir ales de tine, același în App Dashboard → Webhooks → Verify token
META_WEBHOOK_VERIFY_TOKEN=
# Tenant-ul paginilor (lib/tenant.ts): orgId Clerk sau user:<clerkUserId> — de regulă = CRM_PIPELINE_ORG_ID
SOCIAL_ORG_ID=
