// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Booking {
  id                    String   @id @default(cuid())
  full_name             String
  email                 String
  phone                 String?
  company_name          String?
  meeting_date          String
  meeting_time          String
  meeting_topic         String?
  service_desired       String?
  existing_website      String?
  website_url           String?
  website_purpose       String?
  target_audience       String?
  desired_features      String[]
  competitors_reference String?
  desired_result        String?
  budget_range          String?
  timeline              String?
  additional_notes      String?
  meet_link             String?
  calendar_event_id     String?
  status                String   @default("pending")
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt
}

model Contact {
  id           String   @id @default(cuid())
  full_name    String
  email        String
  phone        String?
  company_name String?
  source       String   @default("website")
  status       String   @default("new")
  created_at   DateTime @default(now())
}

model Quote {
  id               String   @id @default(cuid())
  contact_id       String
  contact_name     String
  contact_email    String
  title            String
  description      String?
  service_type     String?
  status           String   @default("draft")
  total_amount     Float?
  currency         String   @default("EUR")
  line_items       Json?
  tools_used       String[]
  desired_outcomes String[]
  timeline         String?
  created_at       DateTime @default(now())
}

model Activity {
  id               String   @id @default(cuid())
  type             String
  contact_id       String?
  quote_id         String?
  description      String?
  details          String?
  user_id          String?
  duration_minutes Int?
  outcome          String?
  created_at       DateTime @default(now())
}

model Setting {
  id   String @id
  data Json
}

model ChatSession {
  sessionId           String   @id
  clientEmail         String?
  clientPhone         String?
  startedAt           DateTime @default(now())
  endedAt             DateTime?
  status              String   @default("active")
  firstMessage        String?
  messageCount        Int      @default(0)
  bookedConsultation  Boolean  @default(false)
  userAgent           String?
  referrer            String?
  duration            Int?
  messages            ChatMessage[]
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime @default(now())
}

model EducationalTemplate {
  id         String   @id @default(cuid())
  name       String
  subject    String
  content    String
  service    String?
  is_default Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  scheduledMessages ScheduledMessage[]
}

model ScheduledMessage {
  id            String   @id @default(cuid())
  templateId    String
  template      EducationalTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  serviceFilter String?
  timeFilter    String?
  scheduledAt   DateTime
  status        String   @default("pending")
  createdAt     DateTime @default(now())
}

// ── AI Follow-Up & WhatsApp Automation ─────────────────────────────────────
// Tabelele sunt create prin setup-db-followups.sql; modelele de mai jos
// oglindesc schema pentru tooling (studio / introspect).

model OrganizationSettings {
  // Clerk orgId, sau "user:<clerkUserId>" când organizațiile nu sunt activate
  org_id                  String   @id
  api_key                 String   @unique

  missed_call_sms_enabled Boolean  @default(false)
  missed_call_sms_message String   @default("")

  whatsapp_ai_enabled     Boolean  @default(false)
  whatsapp_system_prompt  String   @default("")
  human_takeover_minutes  Int      @default(3)

  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  @@map("organization_settings")
}

model Conversation {
  id                String   @id @default(uuid())
  org_id            String
  channel           String   @default("whatsapp")
  contact_phone     String
  wa_id             String?
  contact_name      String?

  taken_by_human    Boolean  @default(false)
  taken_by_human_at DateTime?
  taken_by_user_id  String?

  last_message_at   DateTime @default(now())
  created_at        DateTime @default(now())

  messages          ConversationMessage[]

  @@unique([org_id, channel, contact_phone])
  @@index([org_id, last_message_at])
  @@map("conversations")
}

model ConversationMessage {
  id              String       @id @default(uuid())
  conversation_id String
  conversation    Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  // 'user' = clientul, 'assistant' = AI, 'human' = operator uman din CRM
  role            String
  body            String
  twilio_sid      String?
  created_at      DateTime     @default(now())

  @@index([conversation_id, created_at])
  @@map("conversation_messages")
}